# Local PostgreSQL container. These values are for development only.
POSTGRES_DB=academy
POSTGRES_USER=academy
POSTGRES_PASSWORD=academy_local_only
POSTGRES_PORT=5432

# ASP.NET Core reads nested configuration keys with double underscores.
ConnectionStrings__Default='Host=localhost;Port=5432;Database=academy;Username=academy;Password=academy_local_only'
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5080

# Browser-visible local URL; it contains no secret.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5080
